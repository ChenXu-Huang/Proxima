{
  "name": "proxima",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern, friendly popup for configuring the browser's native proxy settings.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm run test && npm run build:firefox && npm run build:chrome && npm run verify:build"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=20"
  }
}
